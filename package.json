{
  "name": "pi-sinan",
  "version": "0.2.0",
  "description": "Pi extensions for xAI/Grok and OpenAI/Codex subscription image, search, usage, diagnostics, and transport recovery workflows.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "xai",
    "openai-codex"
  ],
  "license": "MIT",
  "author": "yy003x",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yy003x/pi-sinan.git"
  },
  "bugs": {
    "url": "https://github.com/yy003x/pi-sinan/issues"
  },
  "homepage": "https://github.com/yy003x/pi-sinan#readme",
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions/",
    "src/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "npm test && npm run typecheck && npm pack --dry-run",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.0",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "0.86.0",
    "@types/node": "24.10.1",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.1 <1",
    "@earendil-works/pi-coding-agent": ">=0.85.1 <1",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
